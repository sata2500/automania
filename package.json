{
  "name": "automania-next",
  "version": "2.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "seed-admin": "node scripts/seed-admin.mjs",
    "db:migrate": "node create_table.mjs",
    "db:query": "node query_db.mjs",
    "clean-blobs": "tsx scripts/clean-blobs.ts",
    "migrate:r2": "tsx scripts/migrate-blob-to-r2.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sqlite": "tsx scripts/test-sqlite-runtime.ts",
    "test:smoke": "tsx scripts/smoke-unauthenticated.ts",
    "verify": "npm run type-check && npm test && npm run test:sqlite && npm run build",
    "verify:local": "npm run verify && npm run test:smoke",
    "db:sqlite:init": "tsx scripts/init-sqlite.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@aws-sdk/s3-request-presigner": "^3.1114.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google/generative-ai": "^0.24.1",
    "@neondatabase/serverless": "^1.1.0",
    "@serwist/next": "^9.5.12",
    "@types/canvas-confetti": "^1.9.0",
    "@types/file-saver": "^2.0.7",
    "@vercel/blob": "^2.6.1",
    "@vercel/postgres": "^0.10.0",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "^0.45.2",
    "file-saver": "^2.0.5",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.8",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serwist": "^9.5.12",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.7",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
