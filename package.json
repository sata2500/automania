{
  "name": "automania-next",
  "version": "2.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "seed-admin": "node scripts/seed-admin.mjs",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:list-users": "node scripts/db-list-users.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sqlite": "tsx scripts/test-sqlite-runtime.ts",
    "test:smoke": "tsx scripts/smoke-unauthenticated.ts",
    "db:inspect-schema": "node scripts/inspect-production-schema.mjs",
    "verify": "npm run type-check && npm test && npm run test:sqlite && npm run build",
    "verify:local": "npm run verify && npm run test:smoke",
    "db:sqlite:init": "tsx scripts/init-sqlite.ts",
    "db:encrypt-secrets": "tsx scripts/encrypt-secrets.ts",
    "db:generate": "drizzle-kit generate",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google/genai": "^2.27.0",
    "@neondatabase/serverless": "^1.2.0",
    "@serwist/next": "^9.5.12",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "^0.45.3",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serwist": "^9.5.12",
    "sharp": "^0.35.5",
    "sql.js": "^1.14.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
