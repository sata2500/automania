# ─────────────────────────────────────────────────────────────────────────────
# Automania — ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# NEXT_PUBLIC_ ile başlayan değişkenler tarayıcıya gömülür: buraya asla gizli
# anahtar koymayın.
# ─────────────────────────────────────────────────────────────────────────────

# ── Zorunlu ──────────────────────────────────────────────────────────────────
# Neon/PostgreSQL bağlantı dizesi
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Oturum JWT imzalama anahtarı (en az 32 karakter). Örn: openssl rand -base64 48
JWT_SECRET=
# Veritabanındaki Etsy token'ları ve API anahtarlarını şifreleyen anahtar (en az 32 karakter).
# Tanımlanmazsa gizli değerler düz metin saklanır. Değiştirilirse eski şifreli veriler okunamaz.
DATA_ENCRYPTION_KEY=

# Uygulamanın kanonik adresi (OAuth yönlendirmeleri için)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google ile giriş ────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudflare R2 (dosya depolama) ──────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Herkese açık R2 alan adı (boş bırakılırsa dosyalar /api/r2 vekili üzerinden sunulur)
R2_PUBLIC_URL=

# ── Etsy ─────────────────────────────────────────────────────────────────────
# Admin panelinden de girilebilir (veritabanında şifreli saklanır; panel değeri önceliklidir)
ETSY_API_KEY=
ETSY_SHARED_SECRET=
# Canlı (active) yayın varsayılan olarak kapalıdır. Bilinçli bir kararla açmak için ikisini de true yapın.
ETSY_LIVE_PUBLISH_ENABLED=false
NEXT_PUBLIC_ETSY_LIVE_PUBLISH_ENABLED=false

# ── Yapay zeka (admin panelinden de girilebilir) ─────────────────────────────
AI_PROVIDER=google
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_TEXT_MODEL=
AI_IMAGE_MODEL=
AI_VIDEO_MODEL=

# ── Anahtar kelime kazıma ───────────────────────────────────────────────────
SCRAPER_API_KEY=
SCRAPING_PROVIDER=scraperapi
CLOUDFLARE_WORKER_URL=
# Worker'daki WORKER_SECRET ile aynı değer; Worker'ın açık proxy olmasını engeller
CLOUDFLARE_WORKER_SECRET=

# ── Otomasyon ve zamanlayıcı ────────────────────────────────────────────────
# İç çağrılar için paylaşılan anahtar (en az 32 karakter). Tanımlıysa her otomasyon
# çalıştırması ayrı bir fonksiyon çağrısında yürütülür.
INTERNAL_API_TOKEN=
# /api/cron/automation için Bearer anahtarı (en az 32 karakter)
CRON_SECRET=

# ── İstek sınırlama (önerilir) ──────────────────────────────────────────────
# Upstash Redis REST bilgileri; tanımlı değilse sınırlar süreç içi bellekte tutulur
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Vercel KV kullanıyorsanız KV_REST_API_URL / KV_REST_API_TOKEN da desteklenir)

# ── Diğer ────────────────────────────────────────────────────────────────────
# Sunucunun indirmesine izin verilen ek görsel alan adları (virgülle; *.ornek.com desteklenir)
MEDIA_FETCH_ALLOWED_HOSTS=
# Yakalanmamış sunucu hatalarının JSON olarak gönderileceği webhook (isteğe bağlı)
ERROR_REPORT_WEBHOOK_URL=
# Yerel SQLite çalışma zamanı dosyası (npm run db:sqlite:init)
SQLITE_DATABASE_PATH=.data/automania.local.sqlite
